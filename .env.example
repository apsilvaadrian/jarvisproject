# Copie para .env e preencha. O .env NUNCA deve ir para o GitHub (já está no .gitignore).

# ---------------- Servidor
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
# Como o JARVIS chama você: senhor, senhora, chefe, seu nome...
JARVIS_TRATAMENTO=senhor
# Cérebro padrão: auto | claude | openai | gemini | local   (auto = primeiro com chave configurada)
JARVIS_BRAIN=auto

# ---------------- Cérebros (preencha pelo menos um; sem nenhum, roda em modo offline)
# Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# GPT: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Para usar um modelo local gratuito via Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 e OPENAI_MODEL=qwen2.5:7b
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Os modelos "Lite" têm cota gratuita diária bem maior (o 3.5 Flash libera só 20 pedidos/dia)
GEMINI_MODEL=gemini-3.1-flash-lite
# "Pensamento" do modelo: minimal (resposta em ~2 s), low ou high (mais lento, raciocina mais)
GEMINI_THINKING=minimal

# ---------------- ElevenLabs (opcional) — voz clonada na nuvem, rápida e fiel (plano pago)
# Também dá para configurar pela interface: ⚙ → Voz do JARVIS → ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = mais rápido | eleven_multilingual_v2 = mais expressivo
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---------------- Spotify (opcional) — https://developer.spotify.com/dashboard
# Crie um app, marque "Web API" e cadastre a Redirect URI abaixo exatamente igual.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
